# Copie este arquivo para .env e ajuste os valores
# cp .env.example .env

# PostgreSQL
ConnectionStrings__Default=Host=localhost;Port=5432;Database=myproject;Username=postgres;Password=postgres

# JWT (gere com: openssl rand -base64 32)
Jwt__Issuer=modular-monolith
Jwt__Audience=modular-monolith
Jwt__Key=change-me-to-a-random-secret-key-at-least-32-chars
